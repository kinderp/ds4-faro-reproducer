+
+static bool metal_graph_faro_trace_capture_decode(
+        ds4_gpu_graph *g,
+        uint32_t       il,
+        uint32_t       pos) {
+    if (!ds4_faro_trace_wants_layer(il)) return true;
+    if (!g || !metal_graph_ffn_norm(g) ||
+        !metal_graph_router_selected(g) ||
+        !metal_graph_router_weights(g) ||
+        !metal_graph_routed_down(g)) {
+        return false;
+    }
+    if (ds4_gpu_end_commands() == 0) {
+        fprintf(stderr,
+                "ds4: failed to end Metal batch for FARO trace readback\n");
+        return false;
+    }
+
+    int32_t selected[DS4_MAX_EXPERT_USED] = {0};
+    float weights[DS4_MAX_EXPERT_USED] = {0};
+    float *hidden = xmalloc((size_t)DS4_N_EMBD * sizeof(float));
+    float *weighted = xmalloc((size_t)DS4_N_EXPERT_USED *
+                              DS4_N_EMBD * sizeof(float));
+    bool ok =
+        ds4_gpu_tensor_read(metal_graph_router_selected(g), 0, selected,
+                            (uint64_t)DS4_N_EXPERT_USED * sizeof(selected[0])) != 0 &&
+        ds4_gpu_tensor_read(metal_graph_router_weights(g), 0, weights,
+                            (uint64_t)DS4_N_EXPERT_USED * sizeof(weights[0])) != 0 &&
+        ds4_gpu_tensor_read(metal_graph_ffn_norm(g), 0, hidden,
+                            (uint64_t)DS4_N_EMBD * sizeof(float)) != 0 &&
+        ds4_gpu_tensor_read(metal_graph_routed_down(g), 0, weighted,
+                            (uint64_t)DS4_N_EXPERT_USED * DS4_N_EMBD *
+                            sizeof(float)) != 0;
+
+    if (ds4_gpu_begin_commands() == 0) {
+        fprintf(stderr,
+                "ds4: failed to resume Metal batch after FARO trace readback\n");
+        ok = false;
+    }
+    if (ok) {
+        for (uint32_t slot = 0; slot < DS4_N_EXPERT_USED; slot++) {
+            if (selected[slot] != (int32_t)g_faro_trace.target_expert) continue;
+            ok = ds4_faro_trace_record(
+                    il, pos, false, selected[slot], slot, weights[slot],
+                    hidden, weighted + (size_t)slot * DS4_N_EMBD);
+            break;
+        }
+    }
+    free(weighted);
+    free(hidden);
+    return ok;
+}
+
+static bool metal_graph_faro_trace_capture_batch(
+        ds4_gpu_graph *g,
+        uint32_t       il,
+        uint32_t       pos0,
+        uint32_t       n_tokens) {
+    if (!ds4_faro_trace_wants_layer(il)) return true;
+    if (!g || n_tokens == 0 ||
+        !metal_graph_batch_ffn_norm(g) ||
+        !metal_graph_batch_router_selected(g) ||
+        !metal_graph_batch_router_weights(g) ||
+        !metal_graph_batch_routed_down(g)) {
+        return false;
+    }
+    const uint64_t selected_count =
+        (uint64_t)n_tokens * DS4_N_EXPERT_USED;
+    const uint64_t hidden_count = (uint64_t)n_tokens * DS4_N_EMBD;
+    const uint64_t weighted_count =
+        selected_count * DS4_N_EMBD;
+    if (selected_count > SIZE_MAX / sizeof(int32_t) ||
+        hidden_count > SIZE_MAX / sizeof(float) ||
+        weighted_count > SIZE_MAX / sizeof(float)) {
+        return false;
+    }
+    if (ds4_gpu_end_commands() == 0) {
+        fprintf(stderr,
+                "ds4: failed to end Metal batch for FARO prefill trace\n");
+        return false;
+    }
+
+    int32_t *selected = xmalloc((size_t)selected_count * sizeof(int32_t));
+    float *weights = xmalloc((size_t)selected_count * sizeof(float));
+    float *hidden = xmalloc((size_t)hidden_count * sizeof(float));
+    float *weighted = xmalloc((size_t)weighted_count * sizeof(float));
+    bool ok =
+        ds4_gpu_tensor_read(metal_graph_batch_router_selected(g), 0, selected,
+                            selected_count * sizeof(int32_t)) != 0 &&
+        ds4_gpu_tensor_read(metal_graph_batch_router_weights(g), 0, weights,
+                            selected_count * sizeof(float)) != 0 &&
+        ds4_gpu_tensor_read(metal_graph_batch_ffn_norm(g), 0, hidden,
+                            hidden_count * sizeof(float)) != 0 &&
+        ds4_gpu_tensor_read(metal_graph_batch_routed_down(g), 0, weighted,
+                            weighted_count * sizeof(float)) != 0;
+    if (ds4_gpu_begin_commands() == 0) {
+        fprintf(stderr,
+                "ds4: failed to resume Metal batch after FARO prefill trace\n");
+        ok = false;
+    }
+    for (uint32_t t = 0; ok && t < n_tokens &&
+                         g_faro_trace.samples < g_faro_trace.max_samples; t++) {
+        const size_t selected_off = (size_t)t * DS4_N_EXPERT_USED;
+        for (uint32_t slot = 0; slot < DS4_N_EXPERT_USED; slot++) {
+            if (selected[selected_off + slot] !=
+                    (int32_t)g_faro_trace.target_expert) {
+                continue;
+            }
+            const size_t weighted_off =
+                (selected_off + slot) * (size_t)DS4_N_EMBD;
+            ok = ds4_faro_trace_record(
+                    il, pos0 + t, true, selected[selected_off + slot], slot,
+                    weights[selected_off + slot],
+                    hidden + (size_t)t * DS4_N_EMBD,
+                    weighted + weighted_off);
+            break;
+        }
+    }
+    free(weighted);
+    free(hidden);
+    free(weights);
+    free(selected);
+    return ok;
 }
 
