+static double ds4_expert_profile_weight_quantile(
+        const ds4_expert_profile *p,
+        uint32_t                  il,
+        uint32_t                  expert,
+        double                    q) {
+    const uint64_t count = p->hist[il][expert];
+    if (count == 0) return 0.0;
+    uint64_t rank = (uint64_t)ceil(q * (double)count);
+    if (rank == 0) rank = 1;
+    uint64_t seen = 0;
+    for (uint32_t b = 0; b < DS4_EXPERT_PROFILE_WEIGHT_BINS; b++) {
+        seen += p->weight_bins[il][expert][b];
+        if (seen >= rank) {
+            return ((double)b + 0.5) *
+                   DS4_EXPERT_PROFILE_WEIGHT_MAX /
+                   (double)DS4_EXPERT_PROFILE_WEIGHT_BINS;
+        }
+    }
+    return DS4_EXPERT_PROFILE_WEIGHT_MAX;
+}
