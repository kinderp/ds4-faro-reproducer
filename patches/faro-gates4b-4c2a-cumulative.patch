+static bool metal_graph_profile_router_selection_batch(
+        ds4_gpu_graph           *g,
+        const ds4_layer_weights *layer,
+        uint32_t                 il,
+        uint32_t                 pos0,
+        uint32_t                 n_tokens) {
+    if (!g_expert_profile.active && !g_faro_routing_trace.active) return true;
+    if (!g || !layer || !metal_graph_batch_router_selected(g) ||
+        !metal_graph_batch_router_weights(g) || n_tokens == 0) {
+        return false;
+    }
+    const uint64_t count = (uint64_t)n_tokens * DS4_N_EXPERT_USED;
+    if (count > SIZE_MAX / sizeof(int32_t) ||
+        count > SIZE_MAX / sizeof(float)) {
+        return false;
+    }
+    if (ds4_gpu_end_commands() == 0) {
+        fprintf(stderr,
+                "ds4: failed to end Metal batch for FARO routing histogram\n");
+        return false;
+    }
+    int32_t *selected = xmalloc((size_t)count * sizeof(int32_t));
+    float *weights = xmalloc((size_t)count * sizeof(float));
+    bool ok =
+        ds4_gpu_tensor_read(metal_graph_batch_router_selected(g), 0, selected,
+                            count * sizeof(int32_t)) != 0 &&
+        ds4_gpu_tensor_read(metal_graph_batch_router_weights(g), 0, weights,
+                            count * sizeof(float)) != 0;
+    if (ds4_gpu_begin_commands() == 0) ok = false;
+    if (ok) {
+        for (uint32_t t = 0; t < n_tokens; t++) {
+            const size_t off = (size_t)t * DS4_N_EXPERT_USED;
