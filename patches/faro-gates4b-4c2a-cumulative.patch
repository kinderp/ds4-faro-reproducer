+static int cli_compare_double(const void *lhs, const void *rhs) {
+    const double a = *(const double *)lhs;
+    const double b = *(const double *)rhs;
+    return (a > b) - (a < b);
+}
+
+static double cli_percentile(double *values, int count, double q) {
+    if (!values || count <= 0) return 0.0;
+    qsort(values, (size_t)count, sizeof(values[0]), cli_compare_double);
+    const double position = q * (double)(count - 1);
+    const int low = (int)floor(position);
+    const int high = (int)ceil(position);
+    return values[low] + (values[high] - values[low]) *
+        (position - (double)low);
+}
+
+static void cli_log_token_latency(
+        double prefill_started,
+        const double *token_times,
+        int generated) {
+    if (!token_times || generated <= 0) return;
+    const double ttft = token_times[0] - prefill_started;
+    if (generated == 1) {
+        ds4_log(stderr,
+                DS4_LOG_TIMING,
+                "ds4: TTFT after engine ready: %.3f s; ITL: unavailable "
+                "(one generated token)\n",
+                ttft);
+        return;
+    }
+    const int count = generated - 1;
+    double *deltas = malloc((size_t)count * sizeof(deltas[0]));
+    if (!deltas) {
+        ds4_log(stderr,
+                DS4_LOG_TIMING,
+                "ds4: TTFT after engine ready: %.3f s; ITL allocation failed\n",
+                ttft);
+        return;
+    }
+    for (int i = 1; i < generated; i++) {
+        deltas[i - 1] = 1000.0 * (token_times[i] - token_times[i - 1]);
+    }
+    const double p50 = cli_percentile(deltas, count, 0.50);
+    const double p95 = cli_percentile(deltas, count, 0.95);
+    ds4_log(stderr,
+            DS4_LOG_TIMING,
+            "ds4: TTFT after engine ready: %.3f s; ITL P50: %.3f ms, "
+            "P95: %.3f ms, samples: %d\n",
+            ttft,
+            p50,
+            p95,
+            count);
+    free(deltas);
+}
