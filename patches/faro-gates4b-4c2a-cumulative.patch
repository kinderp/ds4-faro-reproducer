+#ifndef DS4_NO_GPU
+typedef struct faro_gate4c2a_state_signatures {
+    uint64_t raw_kv[DS4_MAX_LAYER];
+    uint64_t attn_state[DS4_MAX_LAYER];
+    uint64_t index_state[DS4_MAX_LAYER];
+    uint32_t checkpoint_len;
+    uint32_t mtp_n_raw;
+    uint32_t dspark_cache_start;
+    uint32_t dspark_cache_token_start;
+    uint32_t dspark_cache_len;
+} faro_gate4c2a_state_signatures;
+
+static uint64_t faro_gate4c2a_hash_update(
+        uint64_t hash, const void *data, size_t size) {
+    const unsigned char *p = data;
+    for (size_t i = 0; i < size; i++) {
+        hash ^= (uint64_t)p[i];
+        hash *= 1099511628211ull;
+    }
+    return hash;
+}
+
+static bool faro_gate4c2a_hash_tensor_range(
+        ds4_gpu_tensor *tensor,
+        uint64_t offset,
+        uint64_t bytes,
+        uint64_t *hash) {
+    if (!tensor || !hash || bytes == 0u) return false;
+    void *buffer = xmalloc((size_t)bytes);
+    const bool ok =
+        ds4_gpu_tensor_read(tensor, offset, buffer, bytes) != 0;
+    if (ok) {
+        *hash = faro_gate4c2a_hash_update(
+                *hash, buffer, (size_t)bytes);
+    }
+    free(buffer);
+    return ok;
+}
+
+/*
+ * Diagnostic-only signatures. They read only the newly written raw KV rows
+ * and the small recurrent compressor frontiers; they never enter a timing
+ * sample. Hashes stay inside the process and only mismatch counts are
+ * exported.
+ */
+static bool faro_gate4c2a_capture_state_signatures(
+        ds4_session *s,
+        uint32_t start,
+        uint32_t block_size,
+        faro_gate4c2a_state_signatures *out) {
+    if (!s || !out || block_size == 0u) return false;
+    memset(out, 0, sizeof(*out));
+    ds4_gpu_graph *g = &s->graph;
+    out->checkpoint_len = (uint32_t)s->checkpoint.len;
+    out->mtp_n_raw = g->mtp_n_raw;
+    out->dspark_cache_start = g->dspark_cache_start;
+    out->dspark_cache_token_start = g->dspark_cache_token_start;
+    out->dspark_cache_len = g->dspark_cache_len;
+    const uint64_t raw_row_bytes =
+        (uint64_t)DS4_N_HEAD_DIM * sizeof(float);
+    bool ok = true;
+    for (uint32_t il = 0; ok && il < DS4_N_LAYER; il++) {
+        if (g->layer_raw_cache[il]) {
+            uint64_t hash = 1469598103934665603ull;
+            const uint32_t row0 = start % g->raw_cap;
+            const uint32_t first_rows =
+                block_size < g->raw_cap - row0
+                    ? block_size : g->raw_cap - row0;
+            ok = faro_gate4c2a_hash_tensor_range(
+                    g->layer_raw_cache[il],
+                    (uint64_t)row0 * raw_row_bytes,
+                    (uint64_t)first_rows * raw_row_bytes,
+                    &hash);
+            if (ok && first_rows < block_size) {
+                ok = faro_gate4c2a_hash_tensor_range(
+                        g->layer_raw_cache[il],
+                        0,
+                        (uint64_t)(block_size - first_rows) *
+                            raw_row_bytes,
+                        &hash);
+            }
+            out->raw_kv[il] = hash;
+        }
+        const uint32_t ratio = ds4_layer_compress_ratio(il);
+        if (!ok || ratio == 0u) continue;
+        uint64_t attn_hash = 1469598103934665603ull;
+        const uint64_t attn_bytes =
+            ds4_gpu_tensor_bytes(g->layer_attn_state_kv[il]);
+        ok = faro_gate4c2a_hash_tensor_range(
+                g->layer_attn_state_kv[il], 0, attn_bytes,
+                &attn_hash) &&
+             faro_gate4c2a_hash_tensor_range(
+                g->layer_attn_state_score[il], 0, attn_bytes,
+                &attn_hash);
+        out->attn_state[il] = attn_hash;
+        if (!ok || ratio != 4u) continue;
+        uint64_t index_hash = 1469598103934665603ull;
+        const uint64_t index_bytes =
+            ds4_gpu_tensor_bytes(g->layer_index_state_kv[il]);
+        ok = faro_gate4c2a_hash_tensor_range(
+                g->layer_index_state_kv[il], 0, index_bytes,
+                &index_hash) &&
+             faro_gate4c2a_hash_tensor_range(
+                g->layer_index_state_score[il], 0, index_bytes,
+                &index_hash);
+        out->index_state[il] = index_hash;
+    }
+    return ok;
+}
+#endif
