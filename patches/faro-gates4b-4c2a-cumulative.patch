+/* =========================================================================
+ * FARO targeted routed-expert trace export.
+ * =========================================================================
+ *
+ * This path is dormant unless both --faro-trace-config and
+ * --faro-trace-output are supplied.  It never records prompts, token ids,
+ * text, logits, or full-model outputs.  The runtime trace is deliberately an
+ * intermediate private file: FARO's standalone packer converts it to the
+ * versioned bundle, performs FP16 conversion, writes hashes, and validates the
+ * result.
+ *
+ * The normal fast Metal MoE path may fuse the down projections and sum without
+ * materializing six expert rows.  Trace initialization therefore enables the
+ * private, opt-in materialization path before any traced inference begins.
+ * The trace stores the matching weighted F32 row from routed_down.
+ * The raw row is mathematically recoverable by division by the non-zero router
+ * weight; the bundle records this provenance instead of claiming that a second
+ * weight=1 Metal dispatch was executed.
+ */
+
+enum {
+    FARO_TRACE_FORMAT_VERSION = 1,
+    FARO_TRACE_HEADER_BYTES = 64,
+    FARO_TRACE_RECORD_HEADER_BYTES = 32
+};
+
+typedef struct {
+    bool active;
+    bool failed;
+    uint32_t target_layer;
+    uint32_t target_expert;
+    uint64_t max_samples;
+    uint64_t max_bytes;
+    uint64_t min_free_bytes;
+    uint64_t samples;
+    uint64_t bytes_written;
+    uint64_t candidates;
+    char *output_dir;
+    char partial_path[PATH_MAX];
+    char final_path[PATH_MAX];
+    FILE *fp;
+    bool materialize_env_owned;
+    bool batch_addr_disable_env_owned;
+} ds4_faro_trace_state;
+
+static ds4_faro_trace_state g_faro_trace;
+
+static void faro_u32le(uint8_t out[4], uint32_t v) {
+    out[0] = (uint8_t)(v);
+    out[1] = (uint8_t)(v >> 8);
+    out[2] = (uint8_t)(v >> 16);
+    out[3] = (uint8_t)(v >> 24);
+}
+
+static void faro_u64le(uint8_t out[8], uint64_t v) {
+    for (uint32_t i = 0; i < 8; i++) out[i] = (uint8_t)(v >> (8u * i));
+}
+
+static bool faro_trace_write_all(FILE *fp, const void *data, size_t bytes) {
+    return fp && (bytes == 0 || fwrite(data, 1, bytes, fp) == bytes);
+}
+
+static bool faro_trace_dir_empty(const char *path) {
+    DIR *dir = opendir(path);
+    if (!dir) return false;
+    bool empty = true;
+    struct dirent *ent;
+    while ((ent = readdir(dir)) != NULL) {
+        if (!strcmp(ent->d_name, ".") || !strcmp(ent->d_name, "..")) continue;
+        empty = false;
+        break;
+    }
+    closedir(dir);
+    return empty;
+}
+
+static bool faro_trace_json_u64(
+        const char *json,
+        const char *key,
+        uint64_t   *out) {
+    char needle[96];
+    if (!json || !key || !out ||
+        snprintf(needle, sizeof(needle), "\"%s\"", key) >= (int)sizeof(needle)) {
+        return false;
+    }
+    const char *p = strstr(json, needle);
+    if (!p) return false;
+    p += strlen(needle);
+    while (*p && isspace((unsigned char)*p)) p++;
+    if (*p++ != ':') return false;
+    while (*p && isspace((unsigned char)*p)) p++;
+    if (!isdigit((unsigned char)*p)) return false;
+    errno = 0;
+    char *end = NULL;
+    unsigned long long v = strtoull(p, &end, 10);
+    if (errno || end == p) return false;
+    *out = (uint64_t)v;
+    return true;
+}
+
+static char *faro_trace_read_config(const char *path) {
+    struct stat st;
+    if (!path || stat(path, &st) != 0 || st.st_size <= 0 ||
+        st.st_size > 64 * 1024) {
+        fprintf(stderr,
+                "ds4: FARO trace config must be a regular JSON file <= 64 KiB\n");
+        return NULL;
+    }
+    FILE *fp = fopen(path, "rb");
+    if (!fp) return NULL;
+    char *json = xmalloc((size_t)st.st_size + 1u);
+    const size_t got = fread(json, 1, (size_t)st.st_size, fp);
+    const int close_ok = fclose(fp) == 0;
+    if (got != (size_t)st.st_size || !close_ok) {
+        free(json);
+        return NULL;
+    }
+    json[got] = '\0';
+    return json;
+}
+
+static bool faro_trace_free_space_ok(const ds4_faro_trace_state *s) {
+    struct statvfs vfs;
+    if (!s || !s->output_dir || statvfs(s->output_dir, &vfs) != 0) return false;
+    const uint64_t free_bytes =
+        (uint64_t)vfs.f_bavail * (uint64_t)vfs.f_frsize;
+    return free_bytes >= s->min_free_bytes;
+}
+
+static bool faro_trace_write_header(ds4_faro_trace_state *s) {
+    uint8_t h[FARO_TRACE_HEADER_BYTES] = {0};
+    memcpy(h, "FAROTR1", 7);
+    faro_u32le(h + 8, FARO_TRACE_FORMAT_VERSION);
+    faro_u32le(h + 12, FARO_TRACE_HEADER_BYTES);
+    faro_u32le(h + 16, DS4_N_EMBD);
+    faro_u32le(h + 20, DS4_N_EXPERT_USED);
+    faro_u32le(h + 24, s->target_layer);
+    faro_u32le(h + 28, s->target_expert);
+    faro_u64le(h + 32, s->max_samples);
+    faro_u64le(h + 40, s->max_bytes);
+    /* flags: bit 0 = hidden F32, bit 1 = weighted expert output F32. */
+    faro_u32le(h + 48, 3u);
+    return faro_trace_write_all(s->fp, h, sizeof(h));
+}
+
+static bool ds4_faro_trace_init(
+        const char *config_path,
+        const char *output_dir) {
+    if ((!config_path || !config_path[0]) &&
+        (!output_dir || !output_dir[0])) {
+        return true;
+    }
+    if (!config_path || !config_path[0] || !output_dir || !output_dir[0]) {
+        fprintf(stderr,
+                "ds4: FARO trace requires both --faro-trace-config and "
+                "--faro-trace-output\n");
+        return false;
+    }
+    if (g_faro_trace.active) {
+        fprintf(stderr, "ds4: FARO trace was initialized more than once\n");
+        return false;
+    }
+
+    char *json = faro_trace_read_config(config_path);
+    if (!json) {
+        fprintf(stderr, "ds4: failed to read FARO trace config %s\n", config_path);
+        return false;
+    }
+    uint64_t schema = 0, layer = 0, expert = 0, max_samples = 0;
+    uint64_t max_bytes = 0, min_free_bytes = 0;
+    const bool parsed =
+        faro_trace_json_u64(json, "schema_version", &schema) &&
+        faro_trace_json_u64(json, "target_layer", &layer) &&
+        faro_trace_json_u64(json, "target_expert", &expert) &&
+        faro_trace_json_u64(json, "max_samples", &max_samples) &&
+        faro_trace_json_u64(json, "max_bytes", &max_bytes) &&
+        faro_trace_json_u64(json, "min_free_bytes", &min_free_bytes);
+    free(json);
+    const uint64_t record_bytes =
+        FARO_TRACE_RECORD_HEADER_BYTES +
+        2u * (uint64_t)DS4_N_EMBD * sizeof(float);
+    if (!parsed || schema != 1u ||
+        layer >= DS4_N_LAYER || expert >= DS4_N_EXPERT ||
+        max_samples == 0 || max_samples > 100000u ||
+        max_bytes < record_bytes ||
+        max_bytes > 2ull * 1024ull * 1024ull * 1024ull ||
+        min_free_bytes < 1024ull * 1024ull * 1024ull) {
+        fprintf(stderr,
+                "ds4: invalid FARO trace config; require schema=1, valid "
+                "layer/expert, 1..100000 samples, max_bytes <= 2 GiB, and "
+                "min_free_bytes >= 1 GiB\n");
+        return false;
+    }
+
+    /*
+     * The production IQ2/Q2 streaming kernels may write only the six-expert
+     * sum, leaving routed_down untouched.  A trace needs the selected expert's
+     * individual output, so force the slower materializing path only while the
+     * explicit FARO trace mode is active.  These process-local variables do
+     * not persist after DS4 exits.
+     */
+    const bool materialize_env_owned =
+        getenv("DS4_METAL_FARO_TRACE_MATERIALIZE_EXPERT_OUTPUT") == NULL;
+    const bool batch_addr_disable_env_owned =
+        getenv("DS4_METAL_DISABLE_STREAMING_PREFILL_BATCH_SELECTED_ADDR") == NULL;
+    if ((materialize_env_owned &&
+         setenv("DS4_METAL_FARO_TRACE_MATERIALIZE_EXPERT_OUTPUT", "1", 0) != 0) ||
+        (batch_addr_disable_env_owned &&
+         setenv("DS4_METAL_DISABLE_STREAMING_PREFILL_BATCH_SELECTED_ADDR",
+                "1", 0) != 0)) {
+        fprintf(stderr,
+                "ds4: FARO trace could not enable expert-output materialization\n");
+        return false;
+    }
+
+    struct stat st;
+    if (lstat(output_dir, &st) == 0) {
+        if (!S_ISDIR(st.st_mode) || !faro_trace_dir_empty(output_dir)) {
+            fprintf(stderr,
+                    "ds4: FARO trace output must be a new or empty directory; "
+                    "resume is intentionally unsupported in v1\n");
+            return false;
+        }
+    } else if (errno == ENOENT) {
+        if (mkdir(output_dir, 0700) != 0) {
+            fprintf(stderr, "ds4: could not create FARO trace directory: %s\n",
+                    strerror(errno));
+            return false;
+        }
+    } else {
+        fprintf(stderr, "ds4: cannot inspect FARO trace directory: %s\n",
+                strerror(errno));
+        return false;
+    }
+
+    ds4_faro_trace_state *s = &g_faro_trace;
+    memset(s, 0, sizeof(*s));
+    s->active = true;
+    s->target_layer = (uint32_t)layer;
+    s->target_expert = (uint32_t)expert;
+    s->max_samples = max_samples;
+    s->max_bytes = max_bytes;
+    s->min_free_bytes = min_free_bytes;
+    s->materialize_env_owned = materialize_env_owned;
+    s->batch_addr_disable_env_owned = batch_addr_disable_env_owned;
+    s->output_dir = ds4_strdup(output_dir);
+    if (snprintf(s->partial_path, sizeof(s->partial_path),
+                 "%s/records.faro-trace.partial", output_dir) >=
+            (int)sizeof(s->partial_path) ||
+        snprintf(s->final_path, sizeof(s->final_path),
+                 "%s/records.faro-trace", output_dir) >=
+            (int)sizeof(s->final_path)) {
+        fprintf(stderr, "ds4: FARO trace path is too long\n");
+        s->failed = true;
+        return false;
+    }
+    if (!faro_trace_free_space_ok(s)) {
+        fprintf(stderr,
+                "ds4: FARO trace refused because free space is below configured minimum\n");
+        s->failed = true;
+        return false;
+    }
+    s->fp = fopen(s->partial_path, "wb");
+    if (!s->fp || !faro_trace_write_header(s)) {
+        fprintf(stderr, "ds4: failed to create FARO partial trace\n");
+        s->failed = true;
+        return false;
+    }
+    s->bytes_written = FARO_TRACE_HEADER_BYTES;
+    fprintf(stderr,
+            "ds4: FARO private trace active layer=%u expert=%u max_samples=%" PRIu64
+            " max_bytes=%" PRIu64 " (no prompt/text/token ids)\n",
+            s->target_layer, s->target_expert, s->max_samples, s->max_bytes);
+    return true;
+}
+
+static bool ds4_faro_trace_wants_layer(uint32_t il) {
+    return g_faro_trace.active && !g_faro_trace.failed &&
+           g_faro_trace.samples < g_faro_trace.max_samples &&
+           il == g_faro_trace.target_layer;
+}
+
+static void ds4_faro_trace_restore_fast_path(ds4_faro_trace_state *s) {
+    if (!s) return;
+    if (s->materialize_env_owned) {
+        (void)unsetenv("DS4_METAL_FARO_TRACE_MATERIALIZE_EXPERT_OUTPUT");
+        s->materialize_env_owned = false;
+    }
+    if (s->batch_addr_disable_env_owned) {
+        (void)unsetenv("DS4_METAL_DISABLE_STREAMING_PREFILL_BATCH_SELECTED_ADDR");
+        s->batch_addr_disable_env_owned = false;
+    }
+}
+
+static bool ds4_faro_trace_record(
+        uint32_t     il,
+        uint32_t     pos,
+        bool         prefill,
+        int32_t      expert,
+        uint32_t     slot,
+        float        router_weight,
+        const float *hidden,
+        const float *weighted) {
+    ds4_faro_trace_state *s = &g_faro_trace;
+    if (!ds4_faro_trace_wants_layer(il) ||
+        expert != (int32_t)s->target_expert) {
+        return true;
+    }
+    s->candidates++;
+    if (!hidden || !weighted || !isfinite(router_weight) ||
+        fabsf(router_weight) < 1.0e-12f) {
+        fprintf(stderr,
+                "ds4: FARO trace rejected non-finite/zero router weight\n");
+        s->failed = true;
+        return false;
+    }
+    bool hidden_nonzero = false;
+    bool weighted_nonzero = false;
+    for (uint32_t i = 0; i < DS4_N_EMBD; i++) {
+        if (!isfinite(hidden[i]) || !isfinite(weighted[i])) {
+            fprintf(stderr,
+                    "ds4: FARO trace rejected a non-finite activation/output row\n");
+            s->failed = true;
+            return false;
+        }
+        hidden_nonzero = hidden_nonzero || hidden[i] != 0.0f;
+        weighted_nonzero = weighted_nonzero || weighted[i] != 0.0f;
+    }
+    if (!hidden_nonzero || !weighted_nonzero) {
+        fprintf(stderr,
+                "ds4: FARO trace rejected an all-zero activation/output row; "
+                "the per-expert Metal result was not materialized\n");
+        s->failed = true;
+        return false;
+    }
+    const uint64_t record_bytes =
+        FARO_TRACE_RECORD_HEADER_BYTES +
+        2u * (uint64_t)DS4_N_EMBD * sizeof(float);
+    if (record_bytes > s->max_bytes - s->bytes_written) {
+        fprintf(stderr,
+                "ds4: FARO trace reached configured max_bytes; capture stopped\n");
+        s->samples = s->max_samples;
+        ds4_faro_trace_restore_fast_path(s);
+        return true;
+    }
+    if ((s->samples % 32u) == 0u && !faro_trace_free_space_ok(s)) {
+        fprintf(stderr,
+                "ds4: FARO trace stopped at configured free-space floor\n");
+        s->samples = s->max_samples;
+        ds4_faro_trace_restore_fast_path(s);
+        return true;
+    }
+
+    uint8_t rh[FARO_TRACE_RECORD_HEADER_BYTES] = {0};
+    faro_u64le(rh + 0, s->samples);
+    faro_u32le(rh + 8, il);
+    faro_u32le(rh + 12, (uint32_t)expert);
+    faro_u32le(rh + 16, pos);
+    faro_u32le(rh + 20, slot);
+    memcpy(rh + 24, &router_weight, sizeof(router_weight));
+    rh[28] = prefill ? 1u : 2u;
+    if (!faro_trace_write_all(s->fp, rh, sizeof(rh)) ||
+        !faro_trace_write_all(s->fp, hidden,
+                              (size_t)DS4_N_EMBD * sizeof(float)) ||
+        !faro_trace_write_all(s->fp, weighted,
+                              (size_t)DS4_N_EMBD * sizeof(float))) {
+        fprintf(stderr, "ds4: FARO trace write failed: %s\n", strerror(errno));
+        s->failed = true;
+        return false;
+    }
+    s->samples++;
+    s->bytes_written += record_bytes;
+    if (s->samples >= s->max_samples) {
+        ds4_faro_trace_restore_fast_path(s);
+    }
+    if ((s->samples % 32u) == 0u) {
+        if (fflush(s->fp) != 0) {
+            s->failed = true;
+            return false;
+        }
+    }
+    return true;
+}
+
+static void ds4_faro_trace_close(void) {
+    ds4_faro_trace_state *s = &g_faro_trace;
+    if (!s->active) return;
+    ds4_faro_trace_restore_fast_path(s);
+    bool ok = !s->failed && s->fp && fflush(s->fp) == 0;
+    if (ok) ok = fsync(fileno(s->fp)) == 0;
+    if (s->fp && fclose(s->fp) != 0) ok = false;
+    s->fp = NULL;
+    if (ok && rename(s->partial_path, s->final_path) != 0) ok = false;
+
+    char summary_partial[PATH_MAX];
+    char summary_final[PATH_MAX];
+    if (snprintf(summary_partial, sizeof(summary_partial),
+                 "%s/capture-summary.json.partial", s->output_dir) <
+            (int)sizeof(summary_partial) &&
+        snprintf(summary_final, sizeof(summary_final),
+                 "%s/capture-summary.json", s->output_dir) <
+            (int)sizeof(summary_final)) {
+        FILE *fp = fopen(summary_partial, "wb");
+        if (fp) {
+            fprintf(fp,
+                    "{\n"
+                    "  \"schema_version\": 1,\n"
+                    "  \"status\": \"%s\",\n"
+                    "  \"target_layer\": %u,\n"
+                    "  \"target_expert\": %u,\n"
+                    "  \"samples\": %" PRIu64 ",\n"
+                    "  \"candidate_selections\": %" PRIu64 ",\n"
+                    "  \"bytes\": %" PRIu64 ",\n"
+                    "  \"privacy\": {\"prompt\": false, \"text\": false, "
+                    "\"token_ids\": false, \"logits\": false},\n"
+                    "  \"raw_output_semantics\": "
+                    "\"derive weighted_f32 / router_weight_f32\"\n"
+                    "}\n",
+                    ok ? "complete" : "partial",
+                    s->target_layer,
+                    s->target_expert,
+                    s->samples,
+                    s->candidates,
+                    s->bytes_written);
+            const bool summary_ok =
+                fflush(fp) == 0 && fsync(fileno(fp)) == 0;
+            const bool summary_closed = fclose(fp) == 0;
+            fp = NULL;
+            if (summary_ok && summary_closed && ok) {
+                (void)rename(summary_partial, summary_final);
+            }
+        }
+    }
+    fprintf(stderr,
+            "ds4: FARO trace %s samples=%" PRIu64 " bytes=%" PRIu64 " path=%s\n",
+            ok ? "complete" : "partial",
+            s->samples,
+            s->bytes_written,
+            ok ? s->final_path : s->partial_path);
+    free(s->output_dir);
+    memset(s, 0, sizeof(*s));
+}
+
+/* =========================================================================
+ * FARO bounded routing-sequence trace.
+ * =========================================================================
+ *
+ * This trace contains only anonymous run metadata, relative positions, layer
+ * ids, six expert ids, and six router weights.  It deliberately excludes
+ * prompts, text, token ids, hidden states, expert outputs, and logits.
+ */
+
+enum {
+    FARO_ROUTING_TRACE_VERSION = 1,
+    FARO_ROUTING_TRACE_HEADER_BYTES = 64,
+    FARO_ROUTING_TRACE_RECORD_BYTES = 80
+};
+
+typedef struct {
+    bool active;
+    bool failed;
+    bool limit_reached;
+    uint64_t run_id;
+    uint64_t max_records;
+    uint64_t max_bytes;
+    uint64_t min_free_bytes;
+    uint64_t records;
+    uint64_t prefill_records;
+    uint64_t decode_records;
+    uint64_t bytes_written;
+    double started_sec;
+    char *output_dir;
+    char partial_path[PATH_MAX];
+    char final_path[PATH_MAX];
+    FILE *fp;
+} ds4_faro_routing_trace_state;
+
+static ds4_faro_routing_trace_state g_faro_routing_trace;
+
+static uint32_t faro_routing_trace_checksum(
+        const uint8_t *data,
+        size_t         bytes) {
+    uint32_t h = 2166136261u;
+    for (size_t i = 0; i < bytes; i++) {
+        h ^= data[i];
+        h *= 16777619u;
+    }
+    return h;
+}
+
+static bool faro_routing_trace_free_space_ok(
+        const ds4_faro_routing_trace_state *s) {
+    struct statvfs vfs;
+    if (!s || !s->output_dir || statvfs(s->output_dir, &vfs) != 0) return false;
+    const uint64_t free_bytes =
+        (uint64_t)vfs.f_bavail * (uint64_t)vfs.f_frsize;
+    return free_bytes >= s->min_free_bytes;
+}
+
+static bool faro_routing_trace_write_header(
+        ds4_faro_routing_trace_state *s) {
+    uint8_t h[FARO_ROUTING_TRACE_HEADER_BYTES] = {0};
+    memcpy(h, "FARORT1", 7);
+    faro_u32le(h + 8, FARO_ROUTING_TRACE_VERSION);
+    faro_u32le(h + 12, FARO_ROUTING_TRACE_HEADER_BYTES);
+    faro_u32le(h + 16, FARO_ROUTING_TRACE_RECORD_BYTES);
+    faro_u32le(h + 20, DS4_N_LAYER);
+    faro_u32le(h + 24, DS4_N_EXPERT);
+    faro_u32le(h + 28, DS4_N_EXPERT_USED);
+    faro_u64le(h + 32, s->run_id);
+    faro_u64le(h + 40, s->max_records);
+    faro_u64le(h + 48, s->max_bytes);
+    /* bit 0: prompt absent; bit 1: token ids absent; bit 2: activations absent. */
+    faro_u32le(h + 56, 7u);
+    faro_u32le(h + 60, faro_routing_trace_checksum(h, 60));
+    return faro_trace_write_all(s->fp, h, sizeof(h));
+}
+
+static bool ds4_faro_routing_trace_init(
+        const char *config_path,
+        const char *output_dir) {
+    if ((!config_path || !config_path[0]) &&
+        (!output_dir || !output_dir[0])) {
+        return true;
+    }
+    if (!config_path || !config_path[0] || !output_dir || !output_dir[0]) {
+        fprintf(stderr,
+                "ds4: FARO routing trace requires both config and output\n");
+        return false;
+    }
+    if (g_faro_routing_trace.active) {
+        fprintf(stderr, "ds4: FARO routing trace initialized more than once\n");
+        return false;
+    }
+
+    char *json = faro_trace_read_config(config_path);
+    if (!json) {
+        fprintf(stderr, "ds4: failed to read FARO routing trace config\n");
+        return false;
+    }
+    uint64_t schema = 0, run_id = 0, max_records = 0;
+    uint64_t max_bytes = 0, min_free_bytes = 0;
+    const bool parsed =
+        faro_trace_json_u64(json, "schema_version", &schema) &&
+        faro_trace_json_u64(json, "run_id", &run_id) &&
+        faro_trace_json_u64(json, "max_records", &max_records) &&
+        faro_trace_json_u64(json, "max_bytes", &max_bytes) &&
+        faro_trace_json_u64(json, "min_free_bytes", &min_free_bytes);
+    free(json);
+    if (!parsed || schema != 1u || run_id == 0 ||
+        max_records == 0 || max_records > 10000000u ||
+        max_bytes < FARO_ROUTING_TRACE_HEADER_BYTES +
+                        FARO_ROUTING_TRACE_RECORD_BYTES ||
+        max_bytes > 1024ull * 1024ull * 1024ull ||
+        min_free_bytes < 100ull * 1024ull * 1024ull * 1024ull) {
+        fprintf(stderr,
+                "ds4: invalid routing trace config; require schema=1, nonzero "
+                "run_id, bounded records/bytes, and >=100 GiB free-space floor\n");
+        return false;
+    }
+
+    struct stat st;
+    if (lstat(output_dir, &st) == 0) {
+        if (!S_ISDIR(st.st_mode) || !faro_trace_dir_empty(output_dir)) {
+            fprintf(stderr,
+                    "ds4: routing trace output must be a new or empty directory\n");
+            return false;
+        }
+    } else if (errno == ENOENT) {
+        if (mkdir(output_dir, 0700) != 0) {
+            fprintf(stderr,
+                    "ds4: could not create routing trace directory: %s\n",
+                    strerror(errno));
+            return false;
+        }
+    } else {
+        fprintf(stderr,
+                "ds4: cannot inspect routing trace directory: %s\n",
+                strerror(errno));
+        return false;
+    }
+
+    ds4_faro_routing_trace_state *s = &g_faro_routing_trace;
+    memset(s, 0, sizeof(*s));
+    s->active = true;
+    s->run_id = run_id;
+    s->max_records = max_records;
+    s->max_bytes = max_bytes;
+    s->min_free_bytes = min_free_bytes;
+    s->started_sec = now_sec();
+    s->output_dir = ds4_strdup(output_dir);
+    if (snprintf(s->partial_path, sizeof(s->partial_path),
+                 "%s/routing.faro-routing-trace.partial", output_dir) >=
+            (int)sizeof(s->partial_path) ||
+        snprintf(s->final_path, sizeof(s->final_path),
+                 "%s/routing.faro-routing-trace", output_dir) >=
+            (int)sizeof(s->final_path)) {
+        fprintf(stderr, "ds4: FARO routing trace path is too long\n");
+        s->failed = true;
+        return false;
+    }
+    if (!faro_routing_trace_free_space_ok(s)) {
+        fprintf(stderr,
+                "ds4: routing trace refused below configured free-space floor\n");
+        s->failed = true;
+        return false;
+    }
+    s->fp = fopen(s->partial_path, "wb");
+    if (!s->fp || !faro_routing_trace_write_header(s)) {
+        fprintf(stderr, "ds4: failed to create FARO routing partial trace\n");
+        s->failed = true;
+        return false;
+    }
+    s->bytes_written = FARO_ROUTING_TRACE_HEADER_BYTES;
+    fprintf(stderr,
+            "ds4: FARO private routing trace active run=%" PRIu64
+            " max_records=%" PRIu64 " max_bytes=%" PRIu64
+            " (no prompt/text/token ids/activations/outputs)\n",
+            s->run_id, s->max_records, s->max_bytes);
+    return true;
+}
+
+static bool ds4_faro_routing_trace_record(
+        uint32_t      il,
+        uint32_t      pos,
+        const int32_t selected[DS4_MAX_EXPERT_USED],
+        const float   weights[DS4_MAX_EXPERT_USED],
+        bool          prefill) {
+    ds4_faro_routing_trace_state *s = &g_faro_routing_trace;
+    if (!s->active || s->failed || s->limit_reached) return !s->failed;
+    if (!selected || !weights || il >= DS4_N_LAYER) {
+        s->failed = true;
+        return false;
+    }
+    if (s->records >= s->max_records ||
+        FARO_ROUTING_TRACE_RECORD_BYTES > s->max_bytes - s->bytes_written) {
+        s->limit_reached = true;
+        return true;
+    }
+    if ((s->records % 4096u) == 0u &&
+        !faro_routing_trace_free_space_ok(s)) {
+        fprintf(stderr,
+                "ds4: routing trace stopped at configured free-space floor\n");
+        s->limit_reached = true;
+        return true;
+    }
+
+    uint8_t r[FARO_ROUTING_TRACE_RECORD_BYTES] = {0};
+    faro_u64le(r + 0, s->records);
+    const double elapsed = now_sec() - s->started_sec;
+    const uint64_t relative_ns =
+        elapsed > 0.0 ? (uint64_t)(elapsed * 1000000000.0) : 0u;
+    faro_u64le(r + 8, relative_ns);
+    faro_u32le(r + 16, pos);
+    faro_u32le(r + 20, il);
+    r[24] = prefill ? 1u : 2u;
+    for (uint32_t slot = 0; slot < DS4_N_EXPERT_USED; slot++) {
+        if (selected[slot] < 0 ||
+            (uint32_t)selected[slot] >= DS4_N_EXPERT ||
+            !isfinite(weights[slot])) {
+            fprintf(stderr,
+                    "ds4: routing trace rejected invalid expert id/weight\n");
+            s->failed = true;
+            return false;
+        }
+        faro_u32le(r + 28 + 4u * slot, (uint32_t)selected[slot]);
+        uint32_t bits = 0;
+        memcpy(&bits, &weights[slot], sizeof(bits));
+        faro_u32le(r + 52 + 4u * slot, bits);
+    }
+    faro_u32le(r + 76, faro_routing_trace_checksum(r, 76));
+    if (!faro_trace_write_all(s->fp, r, sizeof(r))) {
+        fprintf(stderr, "ds4: routing trace write failed: %s\n", strerror(errno));
+        s->failed = true;
+        return false;
+    }
+    s->records++;
+    if (prefill) s->prefill_records++;
+    else s->decode_records++;
+    s->bytes_written += sizeof(r);
+    if ((s->records % 4096u) == 0u && fflush(s->fp) != 0) {
+        s->failed = true;
+        return false;
+    }
+    return true;
+}
+
+static void ds4_faro_routing_trace_close(void) {
+    ds4_faro_routing_trace_state *s = &g_faro_routing_trace;
+    if (!s->active) return;
+    bool ok = !s->failed && s->fp && fflush(s->fp) == 0;
+    if (ok) ok = fsync(fileno(s->fp)) == 0;
+    if (s->fp && fclose(s->fp) != 0) ok = false;
+    s->fp = NULL;
+    if (ok && rename(s->partial_path, s->final_path) != 0) ok = false;
+
+    char summary_partial[PATH_MAX];
+    char summary_final[PATH_MAX];
+    const bool paths_ok =
+        snprintf(summary_partial, sizeof(summary_partial),
+                 "%s/routing-summary.json.partial", s->output_dir) <
+            (int)sizeof(summary_partial) &&
+        snprintf(summary_final, sizeof(summary_final),
+                 "%s/routing-summary.json", s->output_dir) <
+            (int)sizeof(summary_final);
+    if (paths_ok) {
+        FILE *fp = fopen(summary_partial, "wb");
+        if (fp) {
+            fprintf(fp,
+                    "{\n"
+                    "  \"schema_version\": 1,\n"
+                    "  \"status\": \"%s\",\n"
+                    "  \"run_id\": %" PRIu64 ",\n"
+                    "  \"records\": %" PRIu64 ",\n"
+                    "  \"prefill_records\": %" PRIu64 ",\n"
+                    "  \"decode_records\": %" PRIu64 ",\n"
+                    "  \"bytes\": %" PRIu64 ",\n"
+                    "  \"limit_reached\": %s,\n"
+                    "  \"layers\": %u,\n"
+                    "  \"experts\": %u,\n"
+                    "  \"experts_per_record\": %u,\n"
+                    "  \"privacy\": {\"prompt\":false,\"text\":false,"
+                    "\"token_ids\":false,\"hidden_state\":false,"
+                    "\"expert_output\":false,\"logits\":false}\n"
+                    "}\n",
+                    ok ? "complete" : "partial",
+                    s->run_id,
+                    s->records,
+                    s->prefill_records,
+                    s->decode_records,
+                    s->bytes_written,
+                    s->limit_reached ? "true" : "false",
+                    DS4_N_LAYER,
+                    DS4_N_EXPERT,
+                    DS4_N_EXPERT_USED);
+            const bool summary_ok =
+                fflush(fp) == 0 && fsync(fileno(fp)) == 0;
+            const bool summary_closed = fclose(fp) == 0;
+            if (ok && summary_ok && summary_closed) {
+                (void)rename(summary_partial, summary_final);
+            }
+        }
+    }
+    fprintf(stderr,
+            "ds4: FARO routing trace %s records=%" PRIu64
+            " prefill=%" PRIu64 " decode=%" PRIu64 " bytes=%" PRIu64 "\n",
+            ok ? "complete" : "partial",
+            s->records,
+            s->prefill_records,
+            s->decode_records,
+            s->bytes_written);
+    free(s->output_dir);
+    memset(s, 0, sizeof(*s));
+}
