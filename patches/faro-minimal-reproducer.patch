+    double t_core_ms;
+    double t_verify_ms;
+    double t_verify_rollback_ms;
+    double t_safe_total_ms;
+    double timing_residual_ms;
+    double commit_ms;
+    double total_ms;
+    /* Batch verifier output versus the exact sequential reference. */
+    double logits_max_abs;
+    double logits_rmse;
+    /* Authoritative committed output versus the same exact reference. */
+    double final_logits_max_abs;
+    double final_logits_rmse;
+    bool batch_all_oracle_tokens_accepted;
+    bool all_oracle_tokens_accepted;
+    bool batch_final_argmax_equal;
