+    uint32_t compressor_count_mismatch_layers;
+    uint32_t index_count_mismatch_layers;
+    uint32_t raw_kv_signature_mismatch_layers;
+    uint32_t attn_state_signature_mismatch_layers;
+    uint32_t index_state_signature_mismatch_layers;
+    uint32_t max_compressor_count_delta;
+    uint32_t max_index_count_delta;
